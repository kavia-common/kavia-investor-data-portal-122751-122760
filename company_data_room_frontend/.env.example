# Supabase project URL and public anon key
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-id.supabase.co
REACT_APP_SUPABASE_KEY=YOUR_PUBLIC_ANON_KEY

# Site URL used for auth redirects (include trailing slash if possible)
# For local development:
REACT_APP_SITE_URL=http://localhost:3000

# Optional: Storage bucket name for documents (defaults to 'documents')
REACT_APP_SUPABASE_DOCS_BUCKET=documents
